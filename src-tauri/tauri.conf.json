{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedPilot",
  "version": "0.4.0",
  "identifier": "com.redpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RedPilot",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 660,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "jayton",
    "copyright": "© 2026 jayton",
    "shortDescription": "Redmine 智能工单助手",
    "longDescription": "自动拉取 Redmine 任务，AI 分类与合并规划，一键回派给提出人，并通过 MCP 供其他 AI 调用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
